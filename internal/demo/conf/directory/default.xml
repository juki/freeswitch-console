<include>
  <!-- The users of this switch, one file each in default/ -->
  <domain name="$${domain}">
    <params>
      <param name="dial-string" value="${sofia_contact(${dialed_user}@${dialed_domain})}"/>
    </params>
    <variables>
      <variable name="user_context" value="default"/>
    </variables>
    <groups>
      <group name="default">
        <users>
          <X-PRE-PROCESS cmd="include" data="default/*.xml"/>
        </users>
      </group>
      <group name="support">
        <users>
          <user id="1004" type="pointer"/>
          <user id="1005" type="pointer"/>
          <user id="1006" type="pointer"/>
        </users>
      </group>
    </groups>
  </domain>
</include>
