<?xml version="1.0"?>
<!-- Sample configuration of the FreeSWITCH Console demo, written for it.
     The simulated switches answer from these files. -->
<document type="freeswitch/xml">
  <X-PRE-PROCESS cmd="include" data="vars.xml"/>

  <section name="configuration" description="Module configuration">
    <X-PRE-PROCESS cmd="include" data="autoload_configs/*.xml"/>
  </section>

  <section name="dialplan" description="Call routing">
    <X-PRE-PROCESS cmd="include" data="dialplan/*.xml"/>
  </section>

  <section name="directory" description="Users and their devices">
    <X-PRE-PROCESS cmd="include" data="directory/*.xml"/>
  </section>
</document>
