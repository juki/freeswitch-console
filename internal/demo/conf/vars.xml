<include>
  <!-- Values used across the configuration as $${name}. The switch sets
       hostname and local_ip_v4 itself before reading this file. -->
  <X-PRE-PROCESS cmd="set" data="domain=$${local_ip_v4}"/>
  <X-PRE-PROCESS cmd="set" data="domain_name=$${domain}"/>
  <X-PRE-PROCESS cmd="set" data="default_password=demo-only-1234"/>

  <!-- Ports of the two SIP profiles -->
  <X-PRE-PROCESS cmd="set" data="internal_sip_port=5060"/>
  <X-PRE-PROCESS cmd="set" data="internal_wss_port=7443"/>
  <X-PRE-PROCESS cmd="set" data="external_sip_port=5080"/>
  <X-PRE-PROCESS cmd="set" data="external_sip_ip=$${local_ip_v4}"/>
  <X-PRE-PROCESS cmd="set" data="external_rtp_ip=$${local_ip_v4}"/>

  <!-- Codecs: WebRTC clients prefer OPUS, the carriers G.711 -->
  <X-PRE-PROCESS cmd="set" data="global_codec_prefs=OPUS,PCMU,PCMA"/>
  <X-PRE-PROCESS cmd="set" data="outbound_codec_prefs=PCMU,PCMA"/>

  <!-- Calls -->
  <X-PRE-PROCESS cmd="set" data="outbound_caller_name=Demo PBX"/>
  <X-PRE-PROCESS cmd="set" data="outbound_caller_id=+13125550100"/>
  <X-PRE-PROCESS cmd="set" data="call_timeout=30"/>
  <X-PRE-PROCESS cmd="set" data="console_loglevel=info"/>

  <!-- Credentials (sample values) -->
  <X-PRE-PROCESS cmd="set" data="event_socket_password=demo-esl-password"/>
  <X-PRE-PROCESS cmd="set" data="carrier_a_password=demo-carrier-a"/>
  <X-PRE-PROCESS cmd="set" data="carrier_b_password=demo-carrier-b"/>
  <X-PRE-PROCESS cmd="set" data="carrier_backup_password=demo-carrier-backup"/>
</include>
