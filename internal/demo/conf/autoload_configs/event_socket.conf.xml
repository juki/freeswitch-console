<configuration name="event_socket.conf" description="Event Socket">
  <settings>
    <!-- The console connects here; only the management networks may. -->
    <param name="listen-ip" value="$${local_ip_v4}"/>
    <param name="listen-port" value="8021"/>
    <param name="password" value="$${event_socket_password}"/>
    <param name="apply-inbound-acl" value="management"/>
  </settings>
</configuration>
